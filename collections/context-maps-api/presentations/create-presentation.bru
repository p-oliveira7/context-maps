meta {
  name: Create a presentation
  type: http
  seq: 3
}

post {
  url: {{host}}/api/presentations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Created from the API client"
  }
}

vars:post-response {
  createdId: res.body.id
}

assert {
  res.status: eq 201
}

docs {
  Creates an empty presentation and keeps its id in the `createdId` variable.
  The "Delete the presentation created above" request (last in this folder) removes it,
  so running the folder or the collection leaves nothing behind. If you send this request
  on its own, delete the presentation afterwards.
}
